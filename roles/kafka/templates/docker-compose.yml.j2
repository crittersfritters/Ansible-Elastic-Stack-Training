services:
  {{ kafka_container_name }}:
    image: {{ kafka_image }}
    container_name: {{ kafka_container_name }}
    network_mode: host
    extra_hosts:
{% for alias in training_lab_container_aliases %}
      - "{{ alias }}={{ training_lab_loopback_address }}"
{% endfor %}
    environment:
      CLUSTER_ID: "{{ kafka_cluster_id }}"
    volumes:
      - "{{ kafka_folder_path }}/data:{{ kafka_container_data_path }}:Z"
      - "{{ kafka_folder_path }}/config:/mnt/shared/config:ro,Z"
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "/opt/kafka/bin/kafka-topics.sh --bootstrap-server 127.0.0.1:9092 --list >/dev/null 2>&1"]
      interval: 10s
      timeout: 10s
      retries: 24
      start_period: 20s

  {{ kafka_ui_container_name }}:
    image: {{ kafka_ui_image }}
    container_name: {{ kafka_ui_container_name }}
    network_mode: host
    extra_hosts:
{% for alias in training_lab_container_aliases %}
      - "{{ alias }}={{ training_lab_loopback_address }}"
{% endfor %}
    depends_on:
      {{ kafka_container_name }}:
        condition: service_healthy
    environment:
      KAFKA_CLUSTERS_0_NAME: local
      KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS: "kafka.local:9092"
      SERVER_ADDRESS: "127.0.0.1"
    restart: unless-stopped

  {{ kafka_topics_init_container_name }}:
    image: {{ kafka_image }}
    container_name: {{ kafka_topics_init_container_name }}
    network_mode: host
    extra_hosts:
{% for alias in training_lab_container_aliases %}
      - "{{ alias }}={{ training_lab_loopback_address }}"
{% endfor %}
    depends_on:
      {{ kafka_container_name }}:
        condition: service_healthy
    command:
      - /bin/bash
      - -ec
      - |
          export PATH="$$PATH:/opt/kafka/bin"
          attempts=0
          until kafka-topics.sh --bootstrap-server 127.0.0.1:9092 --list >/dev/null 2>&1; do
            attempts=$$((attempts + 1))
            if [ "$$attempts" -ge 60 ]; then
              echo "Kafka did not become ready after 300 seconds" >&2
              exit 1
            fi
            sleep 5
          done
{% for topic in required_kafka_topics %}
          kafka-topics.sh --create --if-not-exists --bootstrap-server 127.0.0.1:9092 --topic {{ topic }} --partitions 1 --replication-factor 1
{% endfor %}
    restart: "no"
