# shellcheck shell=bash
#
# Runtime and repository contract for the answer-sheet validation harness.
# Every value can be overridden in the environment before validate.sh runs.

REQUIRED_PATHS="${REQUIRED_PATHS:-
README.md
.gitlab-ci.yml
.gitlab/deploy.yml
ansible.cfg
requirements.yml
site-config.yml
roles-all.yml
roles-system_files_setup.yml
roles-elasticsearch_nodes.yml
roles-web_servers.yml
roles-queue_nodes.yml
roles-logstash_nodes.yml
roles-logstash_port-router.yml
roles-network_sensors.yml
group_vars/all/main.yml
group_vars/all/elastic-stack.yml
group_vars/all/elastic-assets.yml
group_vars/all/kafka.yml
group_vars/all/mission.yml
group_vars/all/network-sensors.yml
group_vars/all/vault.yml.example
vault_password.sh
bootstrap/gitlab/docker-compose.yml
roles/elasticsearch/templates/docker-compose.yml.j2
roles/kibana/templates/docker-compose.yml.j2
roles/kafka/templates/docker-compose.yml.j2
roles/logstash_pipeline/templates/docker-compose.yml.j2
roles/port_router/templates/docker-compose.yml.j2
roles/filebeat_zeek/templates/docker-compose.yml.j2
roles/filebeat_suricata/templates/docker-compose.yml.j2
roles/filebeat_zeek/defaults/main.yml
roles/filebeat_suricata/defaults/main.yml
roles/common/tasks/verify_docker_selinux.yml
roles/logstash_pipeline/files/config/logstash.yml
roles/logstash_pipeline/files/config/pipelines.yml
roles/logstash_pipeline/files/pipeline/grok_pipeline.conf
roles/logstash_pipeline/files/pipeline/zeek.conf
roles/logstash_pipeline/files/pipeline/suricata.conf
roles/port_router/files/config/logstash.yml
roles/port_router/files/config/pipelines.yml
roles/port_router/files/pipeline/logstash_port-router.conf
roles/filebeat_zeek/templates/filebeat.yml.j2
roles/filebeat_suricata/templates/filebeat.yml.j2
validation/lib/check_sensor_templates.py
validation/lib/check_ci_contract.py
validation/lib/check_inventory.py
}"

INVENTORY_FILE="${INVENTORY_FILE:-site-config.yml}"
MAIN_PLAYBOOK="${MAIN_PLAYBOOK:-roles-all.yml}"
INVENTORY_HOST="${INVENTORY_HOST:-training-lab.local}"
INVENTORY_GROUPS="${INVENTORY_GROUPS:-training_lab_hosts web_servers queue_nodes elasticsearch_nodes network_sensors logstash_nodes port_router_nodes}"

HOST_ALIASES="${HOST_ALIASES:-training-lab.local gitlab.local web.local web kibana.local kibana queue-server.local queue-server kafka.local kafka elasticsearch.local elasticsearch network-sensor.local network-sensor logstash.local logstash logstash-pipeline.local logstash-pipeline log-aggregator.local log-aggregator}"
EXPECTED_ALIAS_ADDRESS="${EXPECTED_ALIAS_ADDRESS:-127.0.0.1}"

DEPLOY_ROOT="${DEPLOY_ROOT:-/var/docker}"
DEPLOYED_COMPOSE_DIRS="${DEPLOYED_COMPOSE_DIRS:-elasticsearch kibana kafka logstash_pipeline logstash_port-router filebeat_zeek filebeat_suricata}"

HEALTHY_CONTAINERS="${HEALTHY_CONTAINERS:-gitlab elasticsearch kafka logstash_pipeline logstash_port-router filebeat_zeek filebeat_suricata}"
RUNNING_CONTAINERS="${RUNNING_CONTAINERS:-kibana kafka-ui}"
COMPLETED_CONTAINERS="${COMPLETED_CONTAINERS:-kafka-topics-init}"

ES_URL="${ES_URL:-http://127.0.0.1:9200}"
KIBANA_URL="${KIBANA_URL:-http://127.0.0.1:5601}"
KAFKA_UI_URL="${KAFKA_UI_URL:-http://127.0.0.1:8080}"
GITLAB_URL="${GITLAB_URL:-http://gitlab.local:8929}"
GITLAB_CONTAINER="${GITLAB_CONTAINER:-gitlab}"
GITLAB_IMAGE="${GITLAB_IMAGE:-gitlab/gitlab-ee:19.4.1-ee.0}"
GITLAB_COMPOSE_PROJECT="${GITLAB_COMPOSE_PROJECT:-gitlab}"
GITLAB_COMPOSE_SERVICE="${GITLAB_COMPOSE_SERVICE:-gitlab}"
GITLAB_COMPOSE_WORKDIR="${GITLAB_COMPOSE_WORKDIR:-/var/training/gitlab}"
GITLAB_COMPOSE_FILE="${GITLAB_COMPOSE_FILE:-/var/training/gitlab/docker-compose.yml}"
GITLAB_EXTERNAL_URL="${GITLAB_EXTERNAL_URL:-http://gitlab.local:8929}"
GITLAB_SSH_PORT="${GITLAB_SSH_PORT:-2424}"
GITLAB_PORT_BINDINGS="${GITLAB_PORT_BINDINGS:-22/tcp:127.0.0.1:2424 443/tcp:127.0.0.1:443 8929/tcp:127.0.0.1:8929}"
GITLAB_MOUNT_BINDINGS="${GITLAB_MOUNT_BINDINGS:-/var/training/gitlab/config:/etc/gitlab /var/training/gitlab/logs:/var/log/gitlab /var/training/gitlab/data:/var/opt/gitlab}"
LOGSTASH_PIPELINE_URL="${LOGSTASH_PIPELINE_URL:-http://127.0.0.1:9600}"
PORT_ROUTER_URL="${PORT_ROUTER_URL:-http://127.0.0.1:9601}"
LOGSTASH_PIPELINE_IDS="${LOGSTASH_PIPELINE_IDS:-zeek suricata grok_pipeline}"
PORT_ROUTER_PIPELINE_ID="${PORT_ROUTER_PIPELINE_ID:-logstash_port-router}"

KAFKA_CONTAINER="${KAFKA_CONTAINER:-kafka}"
KAFKA_BOOTSTRAP_SERVER="${KAFKA_BOOTSTRAP_SERVER:-127.0.0.1:9092}"
KAFKA_TOPICS="${KAFKA_TOPICS:-zeek-group suricata-group mission-group}"

ELASTIC_INDEX_ALIAS_PAIRS="${ELASTIC_INDEX_ALIAS_PAIRS:-search-parsed:active-grok-match search-unparsed:active-unparsed search-zeek:active-zeek search-suricata:active-suricata}"
ELASTIC_TEMPLATE_SPECS="${ELASTIC_TEMPLATE_SPECS:-training-lab-parsed:search-parsed* training-lab-unparsed:search-unparsed* training-lab-zeek:search-zeek* training-lab-suricata:search-suricata*}"
KIBANA_DATA_VIEW_SPECS="${KIBANA_DATA_VIEW_SPECS:-search-parsed:search-parsed* search-unparsed:search-unparsed* search-zeek:search-zeek* search-suricata:search-suricata*}"

ZEEK_FILEBEAT_CONTAINER="${ZEEK_FILEBEAT_CONTAINER:-filebeat_zeek}"
SURICATA_FILEBEAT_CONTAINER="${SURICATA_FILEBEAT_CONTAINER:-filebeat_suricata}"
SURICATA_NATIVE_SELINUX_TYPE="${SURICATA_NATIVE_SELINUX_TYPE:-var_log_t}"
SENSOR_MAX_AGE="${SENSOR_MAX_AGE:-24h}"

MISSION_TCP_HOST="${MISSION_TCP_HOST:-127.0.0.1}"
MISSION_TCP_PORT="${MISSION_TCP_PORT:-4444}"
SAMPLE_WAIT_SECONDS="${SAMPLE_WAIT_SECONDS:-30}"
PARSER_ID_FIELD="${PARSER_ID_FIELD:-_parser.id}"
PAN_SIMPLE_EXPECTED_PARSER="${PAN_SIMPLE_EXPECTED_PARSER:-pan_simple}"
PAN_UNMATCHED_EXPECTED_PARSER="${PAN_UNMATCHED_EXPECTED_PARSER:-unmatched}"
PAN_SIMPLE_EXPECTED_TIMESTAMP_PREFIX="${PAN_SIMPLE_EXPECTED_TIMESTAMP_PREFIX:-2026-01-07T14:22:01}"
PAN_FULL_EXPECTED_PARSER="${PAN_FULL_EXPECTED_PARSER:-pan_full}"
PAN_FULL_EXPECTED_TIMESTAMP_PREFIX="${PAN_FULL_EXPECTED_TIMESTAMP_PREFIX:-2026-01-08T10:45:05}"
PAN_DATE_FAILURE_EXPECTED_PARSER="${PAN_DATE_FAILURE_EXPECTED_PARSER:-pan_simple}"
PAN_MATCH_ALIAS="${PAN_MATCH_ALIAS:-active-grok-match}"
PAN_UNMATCHED_ALIAS="${PAN_UNMATCHED_ALIAS:-active-unparsed}"

LOGSTASH_CONTAINERS="${LOGSTASH_CONTAINERS:-logstash_pipeline logstash_port-router}"
FILEBEAT_CONTAINERS="${FILEBEAT_CONTAINERS:-filebeat_zeek filebeat_suricata}"

LOOPBACK_TCP_PORTS="${LOOPBACK_TCP_PORTS:-4444 5601 8080 9092 9093 9200 9600 9601}"

DOCKER_COMMAND="${DOCKER_COMMAND:-docker}"
IDEMPOTENCE_EVIDENCE="${IDEMPOTENCE_EVIDENCE:-validation/evidence/ansible-idempotence.txt}"
